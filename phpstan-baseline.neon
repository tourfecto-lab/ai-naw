parameters:
	ignoreErrors:
		-
			message: '#^Variable \$appPassword might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: app/Jobs/PublishScheduledArticleJob.php

		-
			message: '#^Variable \$siteUrl might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: app/Jobs/PublishScheduledArticleJob.php

		-
			message: '#^Variable \$username might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: app/Jobs/PublishScheduledArticleJob.php

		-
			message: '#^Variable \$platform on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: app/Jobs/PublishSocialPostJob.php

		-
			message: '#^Variable \$post on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: app/Jobs/PublishSocialPostJob.php

		-
			message: '#^Variable \$size in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.variable
			count: 1
			path: app/Jobs/RenderStoryboardJob.php
